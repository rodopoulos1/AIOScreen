<Window x:Class="AIOScreen.UI.JanelaEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Editor" Height="800" Width="1240" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Fundo}" Foreground="{StaticResource Texto}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{x:Static ApplicationCommands.Delete}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================== barra de título -->
        <Grid Grid.Row="0" Background="{StaticResource Painel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Rectangle Width="3" Height="15" Fill="{StaticResource Brasa}" Margin="0,0,10,0" />
                <TextBlock Text="EDITOR" FontFamily="{StaticResource FonteDisplay}"
                           FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="NomeDoTema" Style="{StaticResource Corpo}" FontSize="11"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Apagado}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource BotaoJanela}" Content="&#xE921;"
                        Click="AoMinimizar" ToolTip="Minimizar" />
                <Button x:Name="BotaoMaximizar" Style="{StaticResource BotaoJanela}" Content="&#xE922;"
                        Click="AoMaximizar" ToolTip="Maximizar" />
                <Button Style="{StaticResource BotaoFechar}" Content="&#xE8BB;"
                        Click="AoCancelar" ToolTip="Fechar sem aplicar" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="272" />
            </Grid.ColumnDefinitions>

            <!-- ================================= paleta: o que inserir -->
            <Border Grid.Column="0" Background="{StaticResource Painel}"
                    BorderBrush="{StaticResource Linha}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,16,10,16">
                        <TextBlock Text="Inserir" Style="{StaticResource Etiqueta}" />
                        <ItemsControl x:Name="Paleta" />

                        <TextBlock Text="Forma do selecionado" Style="{StaticResource Etiqueta}"
                                   Margin="0,20,0,7" />
                        <UniformGrid x:Name="Formas" Columns="2" />

                        <TextBlock Text="Arranjos prontos" Style="{StaticResource Etiqueta}"
                                   Margin="0,20,0,7" />
                        <ItemsControl x:Name="Arranjos" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================================== a mesa: o painel -->
            <Grid Grid.Column="1" Background="#0C0908">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- WrapPanel e não Grid com item alinhado à direita: numa janela
                     estreita o Grid empilhava os controles um POR CIMA do outro,
                     sem nunca quebrar linha. A dica de uso saiu daqui e foi para
                     o rodapé, que já existe e tem largura sobrando. -->
                <Border Grid.Row="0" Background="{StaticResource Painel}"
                        BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1" Padding="16,8">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                            <TextBlock Text="Zoom" Style="{StaticResource Etiqueta}"
                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Slider x:Name="Zoom" Style="{StaticResource Deslizante}" Width="110"
                                    Minimum="100" Maximum="300" Value="100" TickFrequency="5"
                                    VerticalAlignment="Center" ValueChanged="AoMudarEnquadramento" />
                            <TextBlock x:Name="ValorZoom" Text="100%" Style="{StaticResource Corpo}"
                                       Width="42" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,24,4">
                            <TextBlock Text="Escurecer" Style="{StaticResource Etiqueta}"
                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Slider x:Name="Escurecer" Style="{StaticResource Deslizante}" Width="110"
                                    Minimum="0" Maximum="90" Value="50" TickFrequency="5"
                                    VerticalAlignment="Center" ValueChanged="AoMudarEscurecer" />
                            <TextBlock x:Name="ValorEscurecer" Text="50%" Style="{StaticResource Corpo}"
                                       Width="42" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox x:Name="MostrarGrade" Content="Grade" VerticalAlignment="Center"
                                  Margin="0,4,0,4" Click="AoMudarGrade"
                                  ToolTip="Guias de centro e terços, com encaixe ao arrastar" />
                    </WrapPanel>
                </Border>

                <!--
                    O painel é redondo: fora do círculo o vidro corta, então a
                    mesa mostra esse limite em vez de um quadrado.

                    Tudo vive dentro de um Viewbox sobre uma área de 480x480, que
                    é a resolução real do painel. Assim a mesa cresce junto com a
                    janela E as coordenadas do mouse já são pixels do painel — sem
                    conversão de escala espalhada pelo código, que é onde esse
                    tipo de editor costuma errar por um fio.
                -->
                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="24" MaxWidth="760" MaxHeight="760">
                    <Border Width="496" Height="496" CornerRadius="248"
                            Background="#0B0808" BorderBrush="{StaticResource Linha}"
                            BorderThickness="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF2A2A" BlurRadius="40" ShadowDepth="0" Opacity="0.16" />
                        </Border.Effect>

                        <Grid x:Name="Mesa" Width="480" Height="480" ClipToBounds="True"
                              Background="Transparent"
                              MouseLeftButtonDown="AoPressionarMesa"
                              MouseMove="AoMoverNaMesa"
                              MouseLeftButtonUp="AoSoltarNaMesa">
                            <Image x:Name="Fundo" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <EllipseGeometry Center="240,240" RadiusX="240" RadiusY="240" />
                                </Image.Clip>
                            </Image>

                            <!-- Guia da área segura: o que passar daqui some no
                                 painel de verdade. -->
                            <Ellipse Width="392" Height="392" Stroke="{StaticResource Brasa}"
                                     StrokeThickness="1" StrokeDashArray="3 5" Opacity="0.30"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsHitTestVisible="False" />

                            <!-- Grade abaixo dos elementos: guia não disputa atenção com o
                                 conteúdo, fica por baixo dele. -->
                            <Canvas x:Name="Grade" Width="480" Height="480"
                                    IsHitTestVisible="False" Visibility="Collapsed" />

                            <Canvas x:Name="Camada" Width="480" Height="480" Background="Transparent" />
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>

            <!-- ============================ camadas e propriedades -->
            <Border Grid.Column="2" Background="{StaticResource Painel}"
                    BorderBrush="{StaticResource Linha}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="14,16,14,0">
                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="Camadas" Style="{StaticResource Etiqueta}" Margin="0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="Subir" Style="{StaticResource BotaoJanela}"
                                        Width="26" Height="22" Content="&#xE70E;" FontSize="9"
                                        Click="AoSubirCamada" ToolTip="Trazer para a frente" />
                                <Button x:Name="Descer" Style="{StaticResource BotaoJanela}"
                                        Width="26" Height="22" Content="&#xE70D;" FontSize="9"
                                        Click="AoDescerCamada" ToolTip="Mandar para trás" />
                                <Button x:Name="Apagar" Style="{StaticResource BotaoJanela}"
                                        Width="26" Height="22" Content="&#xE74D;" FontSize="10"
                                        Click="AoApagarCamada" ToolTip="Apagar" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="Camadas" Height="168" Background="Transparent"
                                 BorderBrush="{StaticResource Linha}" BorderThickness="1"
                                 Foreground="{StaticResource Texto}"
                                 FontFamily="{StaticResource FonteCorpo}" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="AoSelecionarCamada" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="14,16,8,14" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Propriedades" Margin="0,0,6,0">
                            <TextBlock x:Name="SemSelecao" Style="{StaticResource Corpo}" FontSize="11"
                                       Foreground="{StaticResource Apagado}"
                                       Text="Clique num elemento na mesa ou na lista de camadas para editar." />

                            <StackPanel x:Name="BlocoPropriedades" Visibility="Collapsed">
                                <TextBlock x:Name="TituloDoElemento" Style="{StaticResource Titulo}"
                                           FontSize="13" Margin="0,0,0,12" />

                                <StackPanel x:Name="BlocoTexto" Visibility="Collapsed" Margin="0,0,0,12">
                                    <TextBlock Text="Texto" Style="{StaticResource Corpo}"
                                               Foreground="{StaticResource Texto}" Margin="0,0,0,5" />
                                    <TextBox x:Name="TextoLivre" Height="30" Padding="8,5"
                                             Background="{StaticResource Elevado}"
                                             Foreground="{StaticResource Texto}"
                                             BorderBrush="{StaticResource Linha}"
                                             FontFamily="{StaticResource FonteCorpo}" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             TextChanged="AoMudarTexto" />
                                </StackPanel>

                                <Grid>
                                    <TextBlock x:Name="RotuloTamanho" Text="Tamanho"
                                               Style="{StaticResource Corpo}" Foreground="{StaticResource Texto}" />
                                    <TextBlock x:Name="ValorTamanho" Style="{StaticResource Corpo}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="Tamanho" Style="{StaticResource Deslizante}"
                                        Minimum="10" Maximum="230" TickFrequency="1"
                                        ValueChanged="AoMudarTamanho" />

                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="Espessura" Style="{StaticResource Corpo}"
                                               Foreground="{StaticResource Texto}" />
                                    <TextBlock x:Name="ValorEspessura" Style="{StaticResource Corpo}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="Espessura" Style="{StaticResource Deslizante}"
                                        Minimum="2" Maximum="40" TickFrequency="1"
                                        ValueChanged="AoMudarEspessura" />

                                <TextBlock Text="Cor" Style="{StaticResource Etiqueta}" Margin="0,14,0,7" />
                                <ItemsControl x:Name="Paleta2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="BotaoCorLivre" Style="{StaticResource BotaoBase}"
                                        Content="Outra cor..." Padding="10,5" FontSize="11"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Click="AoEscolherCorLivre" />

                                <CheckBox x:Name="ComRotulo" Content="Mostrar rótulo (CPU, GPU, RAM)"
                                          Margin="0,14,0,0" Click="AoMudarRotulo" />

                                <StackPanel x:Name="BlocoArco" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <TextBlock Text="Começo do arco" Style="{StaticResource Corpo}"
                                                   Foreground="{StaticResource Texto}" />
                                        <TextBlock x:Name="ValorInicio" Style="{StaticResource Corpo}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="ArcoInicio" Style="{StaticResource Deslizante}"
                                            Minimum="0" Maximum="360" TickFrequency="5"
                                            ValueChanged="AoMudarArco" />

                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Abertura" Style="{StaticResource Corpo}"
                                                   Foreground="{StaticResource Texto}" />
                                        <TextBlock x:Name="ValorVarredura" Style="{StaticResource Corpo}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="ArcoVarredura" Style="{StaticResource Deslizante}"
                                            Minimum="-350" Maximum="350" TickFrequency="5"
                                            ValueChanged="AoMudarArco" />
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock x:Name="Posicao" Style="{StaticResource Corpo}"
                                               FontSize="11" Foreground="{StaticResource Apagado}" />
                                    <Button Content="Centralizar" Style="{StaticResource BotaoBase}"
                                            Padding="10,4" FontSize="11" HorizontalAlignment="Right"
                                            Click="AoCentralizar" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ====================================================== rodapé -->
        <Border Grid.Row="2" Background="{StaticResource Painel}" BorderBrush="{StaticResource Linha}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="Rodape" Style="{StaticResource Corpo}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,20,0"
                           Text="Arraste para mover · bolinhas redimensionam · setas ajustam · Delete apaga · duplo clique edita texto" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource BotaoBase}" MinWidth="110"
                            Margin="0,0,10,0" Click="AoCancelar" />
                    <Button Content="Aplicar na tela" Style="{StaticResource BotaoPrincipal}"
                            MinWidth="150" Click="AoConfirmar" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
