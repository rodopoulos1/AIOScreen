<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Painel de instrumento térmico, não "gamer RGB".

        O fundo é escuro com viés quente (nunca cinza puro, que denuncia paleta
        não escolhida), e há UM vermelho só. Tudo o mais é neutro para o dado
        poder gritar: se três coisas brilham, nenhuma brilha.
    -->

    <Color x:Key="CorFundo">#14100F</Color>
    <Color x:Key="CorPainel">#1D1817</Color>
    <Color x:Key="CorLinha">#2E2422</Color>
    <Color x:Key="CorBrasa">#FF2A2A</Color>

    <SolidColorBrush x:Key="Fundo"    Color="#14100F" />
    <SolidColorBrush x:Key="Painel"   Color="#1D1817" />
    <SolidColorBrush x:Key="Elevado"  Color="#251E1D" />
    <SolidColorBrush x:Key="Linha"    Color="#2E2422" />
    <SolidColorBrush x:Key="Brasa"    Color="#FF2A2A" />
    <SolidColorBrush x:Key="BrasaFraca" Color="#4A1616" />
    <SolidColorBrush x:Key="Ambar"    Color="#FFC53D" />
    <SolidColorBrush x:Key="Texto"    Color="#F2ECEA" />
    <SolidColorBrush x:Key="Fraco"    Color="#9A8F8C" />
    <SolidColorBrush x:Key="Apagado"  Color="#615755" />

    <!-- Bahnschrift é condensada e industrial, e vem com o Windows 10+. Segoe
         fica para texto corrido. O fallback importa: sem ele a numeração cai
         numa serifada e o painel inteiro muda de caráter. -->
    <FontFamily x:Key="FonteDisplay">Bahnschrift SemiBold, Segoe UI Semibold, Arial</FontFamily>
    <FontFamily x:Key="FonteCorpo">Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="FonteNumero">Bahnschrift, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="Raio">6</sys:Double>

    <!-- ============================================================ texto -->

    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteDisplay}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Apagado}" />
        <!-- Minúscula de propósito. O WPF não tem tracking, e caixa alta sem
             espaçamento fica apertada e grita; o rótulo aqui é para ser lido de
             canto de olho, não para competir com o dado. -->
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style x:Key="Corpo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Fraco}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Numero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteNumero}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
    </Style>

    <!-- =========================================================== caixas -->

    <Style x:Key="Cartao" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Painel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- =========================================================== botões -->

    <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="Background" Value="{StaticResource Elevado}" />
        <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="c" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="c" Property="Background" Value="#302726" />
                            <Setter TargetName="c" Property="BorderBrush" Value="#4A3B39" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="c" Property="Background" Value="#1A1413" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="c" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- O único elemento vermelho cheio da tela: a ação principal. Gastar a
         cor em mais de um lugar mataria a hierarquia. -->
    <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource Brasa}" />
        <Setter Property="BorderBrush" Value="#FF5A4A" />
        <Setter Property="Foreground" Value="#160B0B" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="c" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="c" Property="Background" Value="#FF4A4A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="c" Property="Background" Value="#D81F1F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="c" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoJanela" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Fraco}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="c" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="c" Property="Background" Value="#2A2120" />
                            <Setter Property="Foreground" Value="{StaticResource Texto}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoFechar" TargetType="Button" BasedOn="{StaticResource BotaoJanela}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="c" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="c" Property="Background" Value="{StaticResource Brasa}" />
                            <Setter Property="Foreground" Value="#160B0B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== controles -->

    <!-- O ComboBox precisa de template inteiro. Só trocar Background e
         Foreground não pega: o template padrão do WPF desenha a própria moldura
         clara por cima, e o resultado é uma caixa cinza sem texto visível. -->
    <Style x:Key="ItemDeCombo" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="c" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="c" Property="Background" Value="#302726" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brasa}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="Background" Value="{StaticResource Elevado}" />
        <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ItemDeCombo}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="botao" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="moldura" Background="{StaticResource Elevado}"
                                            BorderBrush="{StaticResource Linha}" BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{StaticResource Fraco}" StrokeThickness="1.5" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="moldura" Property="BorderBrush" Value="#4A3B39" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="valor" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />

                        <Popup x:Name="Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                            <Border Background="{StaticResource Elevado}" BorderBrush="{StaticResource Linha}"
                                    BorderThickness="1" CornerRadius="5" Margin="0,3,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.6" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" Margin="0,4" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A lista de widgets: sem isto o item selecionado fica com o azul do
         Windows, que não existe em nenhum outro lugar desta interface. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Fraco}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="c" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" Margin="0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="c" Property="Background" Value="#251E1D" />
                            <Setter Property="Foreground" Value="{StaticResource Texto}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="c" Property="Background" Value="#301A1A" />
                            <Setter Property="Foreground" Value="{StaticResource Brasa}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider próprio. O do WPF vem com trilho de 4 px chanfrado, marca de
         tique e um polegar losango que não combinam com nada aqui. Este é um
         trilho fino, a parte percorrida em vermelho e um polegar redondo que
         cresce ao passar o mouse. -->
    <Style x:Key="PoleGarInvisivel" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Deslizante" TargetType="Slider">
        <Setter Property="Height" Value="26" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center" Height="26">

                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource Linha}" />

                        <!-- A parte percorrida é um Border dentro do botão de
                             decremento: o Track já faz a conta da largura, então
                             não precisa de conversor nem de código. -->
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PoleGarInvisivel}"
                                              Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{StaticResource Brasa}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PoleGarInvisivel}"
                                              Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb x:Name="polegar" Width="14" Height="14" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="halo" Width="26" Height="26"
                                                         Fill="{StaticResource Brasa}" Opacity="0" />
                                                <Ellipse x:Name="bola" Width="14" Height="14"
                                                         Fill="{StaticResource Texto}"
                                                         Stroke="{StaticResource Brasa}" StrokeThickness="2" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="halo" Property="Opacity" Value="0.18" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="halo" Property="Opacity" Value="0.28" />
                                                    <Setter TargetName="bola" Property="Fill" Value="{StaticResource Brasa}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caixa de marcar própria, pelo mesmo motivo do slider: a padrão é um
         quadrado azul do sistema. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Fraco}" />
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="caixa" Width="17" Height="17" CornerRadius="4"
                                Background="{StaticResource Elevado}"
                                BorderBrush="{StaticResource Linha}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="tique" Data="M 3 8 L 6.5 11.5 L 13 4.5"
                                  Stroke="#160B0B" StrokeThickness="2"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="caixa" Property="BorderBrush" Value="#4A3B39" />
                            <Setter Property="Foreground" Value="{StaticResource Texto}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="caixa" Property="Background" Value="{StaticResource Brasa}" />
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{StaticResource Brasa}" />
                            <Setter TargetName="tique" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Texto}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de rolagem estreita, sem setas nas pontas e sem o cinza do
         sistema. As setas ocupam 34 px em cima e embaixo e ninguém clica nelas
         desde que existe roda de mouse. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Border Width="3" CornerRadius="1.5" HorizontalAlignment="Center"
                                Background="{StaticResource Linha}" />
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PoleGarInvisivel}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PoleGarInvisivel}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="b" Width="5" CornerRadius="2.5"
                                                    HorizontalAlignment="Center"
                                                    Background="#5A4A47" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Brasa}" />
                                                    <Setter TargetName="b" Property="Width" Value="7" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Brasa}" />
                                                    <Setter TargetName="b" Property="Width" Value="7" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="9" />
                            <Setter Property="Width" Value="Auto" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Barra de progresso, sem o brilho animado do Windows.

        O PART_Track precisa ocupar a LARGURA TODA: é dele que o WPF tira a
        medida para dimensionar o PART_Indicator. A primeira versão punha os dois
        num Grid com HorizontalAlignment="Left" — o track ficava com largura
        zero, o indicador também, e a barra nunca enchia por mais que o valor
        subisse.
    -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Brasa}" />
        <Setter Property="Background" Value="{StaticResource Linha}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2"
                            ClipToBounds="True" SnapsToDevicePixels="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" Fill="Transparent" />

                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}"
                                       RadiusX="2" RadiusY="2" />

                            <!-- Estado indeterminado: usado enquanto o painel
                                 reinicia, que é uma espera sem como medir. -->
                            <Rectangle x:Name="Correndo" Width="90" HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}" Opacity="0"
                                       RadiusX="2" RadiusY="2">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="Desloca" X="-90" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0" />
                            <Setter TargetName="Correndo" Property="Opacity" Value="0.85" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Vai">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Desloca"
                                                         Storyboard.TargetProperty="X"
                                                         From="-90" To="900" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Vai" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Amostra de cor: quadradinho com borda que vira branca no escolhido.
         Sem template próprio o Button do WPF pinta o próprio fundo por cima e a
         cor da amostra some. -->
    <ControlTemplate x:Key="ModeloDeCor" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4" />
    </ControlTemplate>

    <Style x:Key="Aba" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Fraco}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="c" Background="Transparent" CornerRadius="4" Padding="14,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Texto}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="c" Property="Background" Value="{StaticResource Elevado}" />
                            <Setter Property="Foreground" Value="{StaticResource Brasa}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
